# ============================================================
# SparkleClean PH - Notification configuration (copy to .env)
# ============================================================
# Copy this file to `backend/.env` and fill in your values.
# The app works fine without any of these (messages are logged
# instead of sent), so local development needs no setup.

# --- Email (SMTP) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=SparkleClean PH <you@gmail.com>

# --- SMS provider ---
# SMS_PROVIDER=twilio        # or "generic" for a simple HTTP gateway
# SMS_API_KEY=your-api-key
# SMS_SENDER=SparkleClean
# SMS_GATEWAY_URL=https://sms.example.com/send   # for provider="generic"

# --- Twilio (only if SMS_PROVIDER=twilio) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM=+15017122661